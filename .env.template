# ==========================================
# Hochciv Multiplayer - Environment Settings
# Copy to ".env" next to docker-compose.yml and fill in.
# ==========================================

# --- Database Settings ---
# The superuser. Only applied when the database volume is created for the first time.
# POSTGRES_PASSWORD is required (no default) – for an existing database: the password it was
# created with. The server doesn't get it; only the database and the db-setup container use it.
POSTGRES_USER=hochciv
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=hochciv
# The server's two roles, created (and their passwords set) by the db-setup container at every
# `docker compose up`: hochciv_owner runs the migrations, hochciv_app is the server. Required,
# two different values, letters and digits only (they go into a URL) – e.g. openssl rand -hex 24
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
# Where the data lives: Docker volumes (default) or folders next to docker-compose.yml.
# Moving an existing installation: docs/operations/deployment.md#data-next-to-the-compose-file
# POSTGRES_DATA=./data/postgres
# PROMETHEUS_DATA=./data/prometheus
# GRAFANA_DATA=./data/grafana
# MONITORING_CONFIG=./data/monitoring

# --- Security Settings ---
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_string

# Public URL: scheme + host only – no path, no trailing slash, no other characters.
# Used for OAuth callbacks, e-mail links and passkeys.
BASE_URL=https://hochciv.example

# The game (HochCiv/) ships with this repository and the image – there is nothing to configure.

# --- Reverse proxy ---
# Docker network the reverse proxy (Nginx, Nginx Proxy Manager, …) is in. Default: proxy
# PROXY_NETWORK=proxy

# --- Image ---
# Optional: run a specific release instead of "latest", e.g. v1.4.2 (Watchtower then keeps
# that tag – it only updates to a newer image of the same tag)
# HOCHCIV_IMAGE_TAG=latest
# How often Watchtower looks for a new image, in seconds (default 300)
# WATCHTOWER_POLL_INTERVAL=300

# --- Email / SMTP Settings ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Hochciv Server" <noreply@yourdomain.com>
# STARTTLS is required on ports other than 465; "off" allows a server without TLS (not recommended)
# SMTP_REQUIRE_TLS=
# Without SMTP_HOST mails are only logged, with their codes hidden; "on" shows them (testing only)
# MAIL_LOG_CODES=

# --- Push notifications (Android app) – optional ---
# Service account key of the Firebase project: Firebase console → Project settings →
# Service accounts → Generate new private key. Put it on ONE line, base64-encoded:
#   base64 -w0 your-key.json        (Linux)   |   [Convert]::ToBase64String([IO.File]::ReadAllBytes("your-key.json"))   (PowerShell)
# Without it, push is off. Keep the key secret – it can send messages to every app user.
# FCM_SERVICE_ACCOUNT=
