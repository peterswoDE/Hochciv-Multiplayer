# ==========================================
# Hochciv Multiplayer - Environment Settings
# Copy to ".env" next to docker-compose.yml and fill in.
# ==========================================

# --- Database Settings ---
# Only applied when the database volume is created for the first time.
POSTGRES_USER=hochciv
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=hochciv
# Where the database keeps its data: a Docker volume (default) or a folder, e.g. ./postgres
# POSTGRES_DATA=pgdata

# --- Security Settings ---
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_string

# Public URL: scheme + host only – no path, no trailing slash, no other characters.
# Used for OAuth callbacks, e-mail links and passkeys.
BASE_URL=https://hochciv.example

# The game (HochCiv/) ships with this repository and the image – there is nothing to configure.

# --- Reverse proxy ---
# Docker network the reverse proxy (Nginx, Nginx Proxy Manager, …) is in. Default: nginx
# PROXY_NETWORK=nginx

# --- Image ---
# Optional: run a specific release instead of "latest", e.g. v1.4.2 (Watchtower then keeps
# that tag – it only updates to a newer image of the same tag)
# HOCHCIV_IMAGE_TAG=latest
# How often Watchtower looks for a new image, in seconds (default 300)
# WATCHTOWER_POLL_INTERVAL=300

# --- Email / SMTP Settings ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Hochciv Server" <noreply@yourdomain.com>

# --- Push notifications (Android app) – optional ---
# Service account key of the Firebase project: Firebase console → Project settings →
# Service accounts → Generate new private key. Put it on ONE line, base64-encoded:
#   base64 -w0 your-key.json        (Linux)   |   [Convert]::ToBase64String([IO.File]::ReadAllBytes("your-key.json"))   (PowerShell)
# Without it, push is off. Keep the key secret – it can send messages to every app user.
# FCM_SERVICE_ACCOUNT=
