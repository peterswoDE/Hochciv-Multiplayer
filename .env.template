# ==========================================
# Hochciv Multiplayer - Environment Settings
# Copy to ".env" next to docker-compose.yml and fill in.
# ==========================================

# --- Database Settings ---
# Only applied when the database volume is created for the first time.
POSTGRES_USER=hochciv
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=hochciv

# --- Security Settings ---
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_string

# Public URL: scheme + host only – no path, no trailing slash, no other characters.
# Used for OAuth callbacks, e-mail links and passkeys.
BASE_URL=https://hochciv.example

# --- Game engine ---
# Optional but recommended: pin the Hochciv engine to one reviewed commit (full 40-character SHA).
# Empty = whatever is on the branch when the container starts.
CORE_REPO_COMMIT=
# CORE_REPO_URL=https://github.com/timooom-hash/Hochciv.git
# CORE_REPO_BRANCH=main

# --- Image ---
# Optional: run a specific release instead of "latest", e.g. v1.4.2
# HOCHCIV_IMAGE_TAG=latest

# --- Email / SMTP Settings ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Hochciv Server" <noreply@yourdomain.com>
