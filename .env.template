# ==========================================
# Hochciv Multiplayer - Environment Settings
# ==========================================

# --- Database Settings ---
POSTGRES_USER=hochciv
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=hochciv

# --- Security Settings ---
# Generate a strong random string for your session secret
SESSION_SECRET=replace_this_with_a_long_random_string

# Required for constructed OAuth Callback URLs (no trailing slash)
BASE_URL=https://hoochvciv.peterswo.de

# --- Email / SMTP Settings ---
 SMTP_HOST=smtp.gmail.com
 SMTP_PORT=587
 SMTP_USER=your_email@gmail.com
 SMTP_PASS=your_app_password
 SMTP_FROM="Hochciv Server" <noreply@yourdomain.com>
